# ===================================================================
# MINISTER LILIAN NNEJI PORTAL - ENVIRONMENT CONFIGURATION
# ===================================================================
# Nothing here is required to build or deploy the site. The app runs
# with sensible fallbacks if these are unset.

# Admin Dashboard Access Passcode.
# Falls back to "lilian2026" if unset — set this in production.
ADMIN_PASSWORD=lilian2026

# -------------------------------------------------------------------
# EMAIL (optional) — REVERB ticket confirmations, via SMTP
# -------------------------------------------------------------------
# Reverb is parked, so nothing currently sends email. Without these,
# ticket emails are logged to the server console instead of sent.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM="Minister Lilian Nneji <your-email@gmail.com>"

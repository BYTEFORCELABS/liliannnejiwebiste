# -------------------------------------------------------------------
# YOUTUBE LIVE SUBSCRIBER COUNT (Admin Overview tile)
# -------------------------------------------------------------------
# Get a key at console.cloud.google.com:
#   1. Create (or pick) a project
#   2. APIs & Services -> Library -> enable "YouTube Data API v3"
#   3. APIs & Services -> Credentials -> Create credentials -> API key
# It is a public read-only key. No OAuth, no channel login needed.
#
# YOUTUBE_API_KEY=AIzaSy...
#
# Identify the channel by ID (preferred, never changes) OR by handle:
# YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
# YOUTUBE_CHANNEL_HANDLE=@LilianNneji
#
# Until YOUTUBE_API_KEY is set the Overview tile shows a dash and
# explains why on hover. Nothing else is affected.

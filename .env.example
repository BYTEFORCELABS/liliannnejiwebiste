# ===================================================================
# MINISTER LILIAN NNEJI PORTAL - ENVIRONMENT CONFIGURATION
# ===================================================================
# Supabase is required. Everything else falls back to sensible
# defaults if unset.

# Admin Dashboard Access Passcode.
# Falls back to "lilian2026" if unset — set this in production.
ADMIN_PASSWORD=lilian2026

# -------------------------------------------------------------------
# DATABASE (required) — Supabase
# -------------------------------------------------------------------
# Supabase dashboard → Project Settings → API.
# Run supabase/schema.sql then supabase/seed.sql in the SQL Editor first.
# The service role key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------------------------------
# EMAIL (optional) — REVERB ticket confirmations, via Resend
# -------------------------------------------------------------------
# Without RESEND_API_KEY, ticket emails are logged to the server console.
# RESEND_FROM must use a domain verified in Resend → Domains. Until then
# leave it unset: the onboarding@resend.dev test sender only delivers to
# the email address that owns the Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM="Minister Lilian Nneji <tickets@liliannneji.com>"
# RESEND_REPLY_TO=Lilianamadi@yahoo.com

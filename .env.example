# ===================================================================
# MINISTER LILIAN NNEJI PORTAL - ENVIRONMENT CONFIGURATION
# ===================================================================
# Supabase is required. Everything else falls back to sensible
# defaults if unset.

# -------------------------------------------------------------------
# ADMIN SIGN-IN (required) — email one-time codes
# -------------------------------------------------------------------
# Admins sign in with their email and a 6-digit code sent by Resend (below).
# Who is allowed is the admin_users table in Supabase (supabase/schema.sql),
# managed from the dashboard's Admins tab.
# This secret signs the login cookie and the stored code hashes. Use a long
# random value (at least 32 characters), different in every environment:
#   openssl rand -base64 48
# Changing it signs every admin out.
ADMIN_SESSION_SECRET=replace-with-output-of-openssl-rand-base64-48

# -------------------------------------------------------------------
# DATABASE (required) — Supabase
# -------------------------------------------------------------------
# Supabase dashboard → Project Settings → API.
# Run supabase/schema.sql then supabase/seed.sql in the SQL Editor first.
# The service role key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------------------------------
# EMAIL — admin sign-in codes and REVERB tickets, via Resend
# -------------------------------------------------------------------
# Required in production: admin sign-in codes are delivered by email.
# Locally, without RESEND_API_KEY, codes and tickets are printed to the
# terminal running `npm run dev` instead.
# RESEND_FROM must use a domain verified in Resend → Domains. Until then
# leave it unset: the onboarding@resend.dev test sender only delivers to
# the email address that owns the Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM="Minister Lilian Nneji <tickets@liliannneji.com>"
# RESEND_REPLY_TO=Lilianamadi@yahoo.com
